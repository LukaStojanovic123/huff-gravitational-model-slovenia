# Large spatial/data directories — not committed, keep folder via .gitkeep
data/raw/*
!data/raw/.gitkeep

# Quarantined contaminant raw files — kept on disk (never delete), never committed.
# See data/quarantine/README.md for what's here and why.
data/quarantine/*
!data/quarantine/.gitkeep
!data/quarantine/README.md

# data/processed/ — intermediate files, not committed
# Key files regenerated by scripts:
#   spatial_blocks.csv    → regenerated by 06_ml_framework.py if missing
#   roads_noded.gpkg      → regenerated by 02_road_network.py
#   distance_matrix.npy   → regenerated by 03_huff_ahp.py
data/processed/*
!data/processed/.gitkeep

# Large GPKG outputs — not committed, keep folder via .gitkeep
outputs/gpkg/*
!outputs/gpkg/.gitkeep

# Specific large intermediate files (in case they land elsewhere)
huff_od_matrix.csv
huff_NW_od_matrix.csv
ml_input_table.csv
accessibility_combined.csv

# outputs/figures/ and outputs/tables/ ARE committed (small, paper-ready files)

# Standard Python
__pycache__/
*.pyc
*.pyo
.env
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Pre-rerun outputs snapshot (Stage 2B.1) — kept on disk for before/after
# comparison, never committed (large GPKGs). Never delete this directory.
outputs_archive_pre_rerun/

# Pre-NW-refit outputs snapshot — kept on disk for before/after comparison
# of the GI_Final_NotWeighted feature-swap retrain, never committed (large
# GPKGs). Never delete this directory.
outputs_archive_pre_nw_refit/

# Pre-full-pipeline-OpenBLAS-rerun outputs snapshot — the entire Stage 2B/3
# pipeline ran under a since-fixed MKL environment (see the scipy/BLAS crash
# fix commit); this snapshot preserves those MKL-era outputs for before/
# after comparison against openblas_reconciliation.csv. Never committed
# (large GPKGs). Never delete this directory.
outputs_archive_pre_openblas_rerun/
